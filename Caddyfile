# Custom Caddyfile — overrides Railpack's generated static-site config.
# Mirrors Railpack's default behavior (security headers, gzip/zstd, hidden
# dotfiles) and additionally returns 404 for internal docs that must never
# be publicly served.
#
# NOTE: the doc-block rules MUST use `handle` (mutually-exclusive groups,
# evaluated first). A plain `respond @docs 404` placed before file_server is
# silently bypassed because try_files' rewrite runs earlier in the pipeline.
# See https://railpack.com/languages/staticfile/
{
	auto_https off
}

:{$PORT:80} {
	handle /AGENTS.md {
		respond 404
	}
	handle /HANDBOOK.md {
		respond 404
	}
	handle /DESIGN_PARAMETERS.md {
		respond 404
	}
	handle /ROADMAP.md {
		respond 404
	}

	handle {
		header {
			X-XSS-Protection "1; mode=block"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
			-Server
		}
		root * .
		file_server {
			hide .git
			hide .env*
		}
		encode {
			gzip
			zstd
		}
		try_files {path} {path}.html {path}/index.html
	}
}
